{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coitd2.local/schemas/task-result.schema.json",
  "allOf": [
    {
      "$ref": "./base-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "task_result"
        },
        "payload": {
          "type": "object",
          "required": ["selected_ips"],
          "properties": {
            "selected_ips": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["address", "family", "latency_ms", "speed_mbps", "loss_rate", "rank"],
                "properties": {
                  "address": { "type": "string" },
                  "family": { "enum": ["ipv4", "ipv6"] },
                  "latency_ms": { "type": "number" },
                  "speed_mbps": { "type": "number" },
                  "loss_rate": { "type": "number" },
                  "region": { "type": ["string", "null"] },
                  "rank": { "type": "integer" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}