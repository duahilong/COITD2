{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coitd2.local/schemas/base-envelope.schema.json",
  "title": "BaseEnvelope",
  "type": "object",
  "required": ["version", "kind", "id", "source", "timestamps", "meta", "payload"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "timestamps": {
      "type": "object",
      "required": ["created_at", "updated_at"],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "meta": {
      "type": "object"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}