{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coitd2.local/schemas/dns-push-record.schema.json",
  "allOf": [
    {
      "$ref": "./base-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "dns_push_record"
        },
        "payload": {
          "type": "object",
          "required": ["provider", "target", "selected_ips", "before_records", "after_records", "status", "response_summary"],
          "properties": {
            "provider": { "enum": ["aliyun", "cloudflare"] },
            "target": {
              "type": "object",
              "required": ["zone", "record_name", "record_type"],
              "properties": {
                "zone": { "type": "string" },
                "record_name": { "type": "string" },
                "record_type": { "enum": ["A", "AAAA", "CNAME", "TXT"] }
              },
              "additionalProperties": false
            },
            "selected_ips": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["address"],
                "properties": {
                  "address": { "type": "string" },
                  "latency_ms": { "type": ["number", "null"] },
                  "speed_mbps": { "type": ["number", "null"] }
                },
                "additionalProperties": false
              }
            },
            "before_records": {
              "type": "array",
              "items": { "type": "string" }
            },
            "after_records": {
              "type": "array",
              "items": { "type": "string" }
            },
            "status": { "enum": ["success", "failed", "partial"] },
            "response_summary": { "type": "object" }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}