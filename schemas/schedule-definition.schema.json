{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coitd2.local/schemas/schedule-definition.schema.json",
  "allOf": [
    {
      "$ref": "./base-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "schedule_definition"
        },
        "payload": {
          "type": "object",
          "required": ["schedule_name", "template_id", "enabled", "timer"],
          "properties": {
            "schedule_name": { "type": "string" },
            "template_id": { "type": "string" },
            "enabled": { "type": "boolean" },
            "timer": {
              "type": "object",
              "required": ["mode", "expression"],
              "properties": {
                "mode": { "enum": ["calendar", "interval"] },
                "expression": { "type": "string" }
              },
              "additionalProperties": false
            },
            "last_run_at": { "type": ["string", "null"], "format": "date-time" },
            "next_run_at": { "type": ["string", "null"], "format": "date-time" }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}