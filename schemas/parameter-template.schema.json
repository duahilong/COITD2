{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coitd2.local/schemas/parameter-template.schema.json",
  "allOf": [
    {
      "$ref": "./base-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "parameter_template"
        },
        "payload": {
          "type": "object",
          "required": ["template_name", "parameter_values"],
          "properties": {
            "template_name": { "type": "string" },
            "parameter_values": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["enabled", "value"],
                "properties": {
                  "enabled": { "type": "boolean" },
                  "value": {}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}