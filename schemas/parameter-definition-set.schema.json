{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coitd2.local/schemas/parameter-definition-set.schema.json",
  "allOf": [
    {
      "$ref": "./base-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "parameter_definition_set"
        },
        "payload": {
          "type": "object",
          "required": ["groups", "parameters"],
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "label", "cli_flag", "type", "enabled_by_default", "required", "visible", "group", "description"],
                "properties": {
                  "key": { "type": "string" },
                  "label": { "type": "string" },
                  "cli_flag": { "type": "string" },
                  "type": { "enum": ["string", "integer", "number", "boolean", "path"] },
                  "default": {},
                  "enabled_by_default": { "type": "boolean" },
                  "required": { "type": "boolean" },
                  "visible": { "type": "boolean" },
                  "group": { "type": "string" },
                  "description": { "type": "string" },
                  "validation": { "type": "object" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}