{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coitd2.local/schemas/task-log-index.schema.json",
  "allOf": [
    {
      "$ref": "./base-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "task_log_index"
        },
        "payload": {
          "type": "object",
          "required": ["stdout_path", "stderr_path", "highlights"],
          "properties": {
            "stdout_path": { "type": "string" },
            "stderr_path": { "type": "string" },
            "highlights": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["level", "message", "at"],
                "properties": {
                  "level": { "enum": ["info", "warning", "error"] },
                  "message": { "type": "string" },
                  "at": { "type": "string", "format": "date-time" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}